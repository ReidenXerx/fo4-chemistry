# Built, not committed. Both are generated and both are verifiable from source:
#   data/Chemistry.esp   <- python tools/make_esp.py data/Chemistry.esp
#   build/papyrus/       <- scripts/build-papyrus.ps1
# Committing either would mean a checkout could disagree with its own sources and
# nothing would say which was right.
build/
data/*.esp

# Python bytecode from tools/
__pycache__/
*.pyc

# Editor and toolchain leftovers. These carry absolute paths from whichever
# machine produced them, which is the one thing a public repository should not
# be shipping.
.vs/
.vscode/
.idea/
*.user

# Logs pulled off a machine for debugging. Rapport.log contains the Windows user
# name in its file paths; commit one deliberately, into docs/runs/, or not at
# all.
*.log
!docs/runs/*.log
