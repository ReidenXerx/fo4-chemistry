{
  "modName": "Chemistry",
  "displayName": "Chemistry",
  "minMcmVersion": 1,
  "pluginRequirements": [
    "Chemistry.esp"
  ],
  "pages": [
    {
      "pageDisplayName": "Autonomy",
      "content": [
        {
          "type": "text",
          "text": "Chemistry decides who pairs up and which scene plays, on top of Rapport's score. Crowd tolerance is on Rapport's page: both mods use that one number."
        },
        {
          "type": "section",
          "text": "General"
        },
        {
          "type": "switcher",
          "id": "bEnabled:General",
          "text": "Autonomous scenes",
          "help": "Off pauses Chemistry: nothing starts on its own, and Rapport's built-in trigger stays off too.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "slider",
          "id": "fMinimumScore:General",
          "text": "Score needed",
          "help": "The total a pair must reach (Rapport's score plus Chemistry's bonuses). Lower means more scenes.",
          "valueOptions": {
            "min": 0.0,
            "max": 5.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fCooldownHours:General",
          "text": "Rest per person (game hours)",
          "help": "After a scene, each of the two rests this long before another.",
          "valueOptions": {
            "min": 0.0,
            "max": 168.0,
            "step": 1.0,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fPollSeconds:General",
          "text": "Check every (s)",
          "help": "How often Chemistry looks for a pair. Not below 20: a pass can take seconds.",
          "valueOptions": {
            "min": 20.0,
            "max": 300.0,
            "step": 5.0,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fNearMissMargin:General",
          "text": "Near miss within",
          "help": "How close to the bar a passed-over pair must be for the Narrator's 'why nothing happened' line.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "iLogLevel:General",
          "text": "Log detail",
          "help": "0 only actions, 1 the full table when it acts, 2 the table every pass (Rapport.log).",
          "valueOptions": {
            "min": 0,
            "max": 2,
            "step": 1,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "section",
          "text": "Their place"
        },
        {
          "type": "slider",
          "id": "fOwnPlaceBonus:Place",
          "text": "Their own home",
          "help": "Bonus when one of them lives here.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fFactionPlaceBonus:Place",
          "text": "Their faction's place",
          "help": "Bonus in a building their faction owns.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Relationships",
      "content": [
        {
          "type": "section",
          "text": "Bond"
        },
        {
          "type": "slider",
          "id": "fBondWeight:Bond",
          "text": "Bond weight",
          "help": "How much a pair's bond (-1 to +1, Rapport's relationship store) adds to the score.",
          "valueOptions": {
            "min": 0.0,
            "max": 3.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fBondCap:Bond",
          "text": "Bond cap",
          "help": "The most the bond can add or take away. Keeps one couple from owning a settlement.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Personas"
        },
        {
          "type": "slider",
          "id": "fKindredBonus:Personas",
          "text": "Same persona",
          "help": "Bonus when both have the same persona.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fClashPenalty:Personas",
          "text": "Romantic with vulgar",
          "help": "Penalty for a romantic and a vulgar pair.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fAudienceBonus:Personas",
          "text": "Vulgar likes an audience",
          "help": "Bonus per vulgar member when a crowd is watching.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fShyPenalty:Personas",
          "text": "Reticent shy of crowds",
          "help": "Penalty per reticent member when a crowd is watching.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fFaithWeight:Personas",
          "text": "Faithfulness weight",
          "help": "Each NPC has a fixed faithfulness from 0 to 1. Pairing someone married or courting with anyone else costs this times it. 0 turns it off.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "switcher",
          "id": "bLoverSpokenFor:Personas",
          "text": "Your lover is spoken for",
          "help": "Someone who is your lover (through Overture) pays the faithfulness cost with anyone else, and straying is recorded as an affair. Needs Rapport 0.2.1.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "section",
          "text": "Refusals"
        },
        {
          "type": "slider",
          "id": "fRefusalBackoffHours:Refusals",
          "text": "Back off after a refusal (h)",
          "help": "When AAF refuses someone, wait this long, and this much longer again with each further refusal.",
          "valueOptions": {
            "min": 0.0,
            "max": 24.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fRefusalBackoffCap:Refusals",
          "text": "Longest back-off (h)",
          "help": "The wait never grows past this.",
          "valueOptions": {
            "min": 1.0,
            "max": 168.0,
            "step": 1.0,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Debug",
      "content": [
        {
          "type": "text",
          "text": "Chemistry's decision on demand, for testing: who pairs up and which scene plays, chosen now. FORCED skips the bar, resting and backing off; REAL is exactly the pass the timer runs."
        },
        {
          "type": "section",
          "text": "Decide"
        },
        {
          "type": "button",
          "text": "Decide now - FORCED",
          "help": "Chemistry's decision this instant: the best pair Rapport offers, even under the bar, resting or backed off. Still waits for a running scene and the player's held slot.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Chemistry:DebugTriggers",
            "function": "DecideNowForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Decide now - REAL",
          "help": "The ordinary pass, now instead of at the next poll, with every rule. The HUD says what it came to.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Chemistry:DebugTriggers",
            "function": "DecideNowReal",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "Hotkeys"
        },
        {
          "id": "ChemistryDecideNowForced",
          "text": "Decide now - forced",
          "type": "hotkey",
          "help": "Chemistry's decision this instant: the best pair Rapport offers, even under the bar, resting or backed off. Still waits for a running scene and the player's held slot."
        },
        {
          "id": "ChemistryDecideNowReal",
          "text": "Decide now - real",
          "type": "hotkey",
          "help": "The ordinary pass, now instead of at the next poll, with every rule. The HUD says what it came to."
        }
      ]
    }
  ]
}
